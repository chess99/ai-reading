page {
  background: #f7f1e8;
  color: #292524;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx;
}

.section {
  margin-bottom: 36rpx;
}

.eyebrow {
  color: #9a6b2f;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.title {
  margin-top: 8rpx;
  color: #1c1917;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.2;
}

.subtitle {
  margin-top: 14rpx;
  color: #78716c;
  font-size: 28rpx;
  line-height: 1.65;
}

.card {
  display: block;
  box-sizing: border-box;
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(120, 113, 108, 0.18);
  border-radius: 14rpx;
  background: #fffdf8;
}

.card-title {
  color: #1c1917;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.35;
}

.meta {
  margin-top: 8rpx;
  color: #78716c;
  font-size: 24rpx;
  line-height: 1.5;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.chip {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(154, 107, 47, 0.1);
  color: #7c4f1d;
  font-size: 22rpx;
  font-weight: 700;
}

.input {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(120, 113, 108, 0.22);
  border-radius: 12rpx;
  background: #fffdf8;
  color: #292524;
  font-size: 30rpx;
}

.empty {
  padding: 48rpx 24rpx;
  color: #78716c;
  text-align: center;
  font-size: 26rpx;
}
